                ms.name,
                mst.name,
                mstage.name,
                ma.name,
                mar.role_name,
                mac.name,
                sic.staff_ids,
                ts.total_score
            ORDER BY
                tl.date
                DESC
            LIMIT :limit
            OFFSET :offset
