            LEFT JOIN total_scores ts
                ON ts.id_logbook = tl.id
            LEFT JOIN staff_logbook sl
                ON sl.id_logbook = tl.id
            WHERE
                tl.id = :id_logbook
                AND tl.deleted_at IS NULL
            GROUP BY
                tl.id,
                mu.id,
                ma.id,
                ms.id,
                mst.id,
                mstage.id,
                mh.id,
                mar.id,
                mac.id,
                sl.staff_id,
                sl.staff_name,
                ts.total_score
            LIMIT 1
